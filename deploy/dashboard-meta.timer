[Unit]
Description=Refresh homelab dashboard metadata periodically
Documentation=https://github.com/ajpeders/dashboard

[Timer]
# Once shortly after boot so a restarted host has fresh metadata quickly...
OnBootSec=2min
# ...then every 15 minutes. Container labels change only when you deploy
# something, so this does not need to match the dashboard's 30s UI refresh —
# the page re-fetches meta.json every cycle regardless.
OnUnitActiveSec=15min
# Catch up after downtime instead of waiting a full interval.
Persistent=true

[Install]
WantedBy=timers.target
